[gd_scene format=3]

[ext_resource type="Script" path="res://ui/nation_panel.gd" id="1_panel"]

[node name="NationPanel" type="PanelContainer"]
custom_minimum_size = Vector2(320, 0)
script = ExtResource("1_panel")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Icon" type="TextureRect" parent="VBox/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Titles" type="VBoxContainer" parent="VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="NameLabel" type="Label" parent="VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
autowrap_mode = 3

[node name="SubLabel" type="Label" parent="VBox/Header/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.76, 0.84, 1)
theme_override_font_sizes/font_size = 12

[node name="CloseButton" type="Button" parent="VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 0
tooltip_text = "Закрыть (Esc)"
text = "×"
flat = true

[node name="ColorBar" type="ColorRect" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 3)
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
