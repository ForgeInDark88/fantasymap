class_name Legacy
extends RefCounted
## Наследие империи (LegacySystem): память распавшейся великой державы.
## Её осколки (государства с этим наследием) ближе друг к другу, могут
## воссоединиться добровольно, а сильнейший — «собиратель земель» — воюет
## за коренные земли империи. id = индекс в World.legacies.

var id := -1
var name := ""
## Государство-прародитель.
var origin := -1
## Коренные регионы империи на момент распада.
var regions := PackedInt32Array()
var founded_year := 0
## Память живёт до этого года.
var until_year := 0
## Собиратель земель (-1 — пока нет).
var collector := -1
var alive := true
