[gd_resource type="Resource" script_class="BattleLinesDef" format=3]

[ext_resource type="Script" path="res://scripts/data/battle_lines_def.gd" id="1_bl"]

[resource]
script = ExtResource("1_bl")
id = &"clash"
kind = &"battle"
lines = PackedStringArray("Строи сшиблись, копья ломаются о щиты.", "Первая волна {a} разбилась о ряды {b}.", "Лучники {b} осыпают стрелами наступающих.", "Конница {a} врезается во фланг {b}.", "Пехота {b} отбивает натиск, но несёт потери.", "Сеча кипит в центре: ни шагу назад.", "Кто-то кричит о прорыве — но это лишь слух.", "{a} теснит {b} к оврагу.", "Стяг {b} падает и тут же поднимается вновь.", "Ряды смешались; бьются уже не строем, а толпой.", "Резерв {a} вступает в бой.", "{b} контратакует — {a} отходит на шаг.", "Звон стали не смолкает уже который час.", "Раненых уносят в тыл, на их место встают новые.")
