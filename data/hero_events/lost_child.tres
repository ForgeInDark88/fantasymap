[gd_resource type="Resource" script_class="HeroEventDef" format=3]

[ext_resource type="Script" path="res://scripts/data/hero_event_def.gd" id="1_ev"]

[resource]
script = ExtResource("1_ev")
id = &"lost_child"
title = "Потерявшийся ребёнок"
text = "В лесу края {where} плачет ребёнок: он отбился от каравана."
where = &""
weight = 0.8
options = Array[Dictionary]([{"text": "Отвести к своим", "karma": 0.12, "xp": 0.5, "rep": 0.06, "result": "Караванщики не знали, как благодарить."}, {"text": "Оставить у ближайшего жилья", "karma": 0.03, "result": "Пусть о нём позаботятся местные."}, {"text": "Продать работорговцам", "karma": -0.4, "xp": 0.3, "rep": -0.15, "result": "Монеты звенят, но слух о злодействе уже бежит впереди."}])
