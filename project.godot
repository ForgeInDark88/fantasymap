; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fantasy Map Simulator: Races"
config/description="Игра-наблюдатель: процедурный мир, государства разных рас растут, воюют и распадаются."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
WorldState="*res://scripts/autoload/world_state.gd"
Achievements="*res://scripts/autoload/achievements.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[debug]

gdscript/warnings/integer_division=0

[gui]

theme/custom="res://ui/theme/default_theme.tres"

