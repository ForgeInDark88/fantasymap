[gd_resource type="Resource" script_class="HeroEventDef" format=3]

[ext_resource type="Script" path="res://scripts/data/hero_event_def.gd" id="1_ev"]

[resource]
script = ExtResource("1_ev")
id = &"wild_beast"
title = "Логово зверя"
text = "В глуши края {where} герой натыкается на логово огромного зверя. Зверь спит."
where = &"wild"
weight = 1.2
options = Array[Dictionary]([{"text": "Напасть на спящего", "power": 0.9, "risk": 0.15, "xp": 3.0, "result": "Шкура зверя — славный трофей.", "fail": "Зверь проснулся. Герой еле унёс ноги."}, {"text": "Тихо обойти", "xp": 0.3, "result": "Не каждый бой нужно принимать."}, {"text": "Поискать в логове кости прежних героев", "power": 0.5, "risk": 0.1, "xp": 1.0, "item": "ancient_weapon", "result": "Среди костей лежал древний клинок.", "fail": "Зверь шевельнулся — пришлось уходить ни с чем."}])
