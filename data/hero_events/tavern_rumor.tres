[gd_resource type="Resource" script_class="HeroEventDef" format=3]

[ext_resource type="Script" path="res://scripts/data/hero_event_def.gd" id="1_ev"]

[resource]
script = ExtResource("1_ev")
id = &"tavern_rumor"
title = "Слухи в таверне"
text = "В таверне края {where} старый бард рассказывает о кладе в соседних руинах и о звере, что его стережёт."
where = &"nation"
terrain = &""
weight = 1.0
options = Array[Dictionary]([{"text": "Угостить барда и расспросить", "gold": -5.0, "quest": "ruins", "xp": 1.0, "result": "Бард поведал всё, что знал; теперь герой знает, где искать."}, {"text": "Устроить потасовку ради веселья", "karma": -0.08, "xp": 0.5, "rep": -0.05, "result": "Таверна в щепки, стража недовольна."}, {"text": "Спеть с бардом", "karma": 0.03, "xp": 0.3, "rep": 0.03, "result": "Песню о герое теперь поют в этих краях."}])
