[gd_resource type="Resource" script_class="BattleLinesDef" format=3]

[ext_resource type="Script" path="res://scripts/data/battle_lines_def.gd" id="1_bl"]

[resource]
script = ExtResource("1_bl")
id = &"opening"
kind = &"battle"
lines = PackedStringArray("У {place} сошлись войска: {a} и {b}.", "Над полем у {place} поднялись знамёна — {a} против {b}.", "Дозоры донесли: враг рядом. {a} и {b} строятся к бою.", "Рассвет над {place}: {a} выводит полки навстречу {b}.", "Трубы {a} ответили трубам {b} — битва неизбежна.", "{b} преградило путь {a}; отступать некуда.", "Два войска встали друг против друга — {a} и {b}.", "Ветер рвёт стяги: у {place} начинается сражение.", "Барабаны {a} гремят, {b} отвечает боевым кличем.", "Разведчики {a} заметили {b} слишком поздно — бой начался внезапно.", "Под стенами у {place} {a} и {b} сходятся в поле.", "Пыль от колонн {a} и {b} смешалась над {place}.")
