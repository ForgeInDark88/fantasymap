[gd_resource type="Resource" script_class="BattleLinesDef" format=3]

[ext_resource type="Script" path="res://scripts/data/battle_lines_def.gd" id="1_bl"]

[resource]
script = ExtResource("1_bl")
id = &"general"
kind = &"battle"
lines = PackedStringArray("{ga} ведёт войска {a} в первых рядах.", "Полководец {a} — {ga} — бросает резерв в бой.", "{gb} держит центр строя {b}.", "{ga} приказывает обойти врага с фланга.", "{gb} велит лучникам бить по знамёнам {a}.", "Голос {ga} слышен над шумом битвы.", "{gb} медлит с приказом — и теряет время.", "{ga} замечает слабое место в строю {b}.")
