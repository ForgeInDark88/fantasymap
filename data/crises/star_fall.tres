[gd_resource type="Resource" script_class="CrisisDef" format=3]

[ext_resource type="Script" path="res://scripts/data/crisis_def.gd" id="1_cr"]

[resource]
script = ExtResource("1_cr")
id = &"star_fall"
display_name = "Звёздный дождь"
description = "Небо раскалывается; звёзды падают на землю, неся гибель и диковинные металлы."
era_name = "Эпоха Огня"
weight = 0.8
min_year = 100
stage_names = PackedStringArray("Знамения", "Звездопад")
stage_years = PackedInt32Array(3, 12)
stage_effects = Array[Dictionary]([{"stability": -0.02}, {"stability": -0.04, "science_mult": 1.1}])
stage_harvest = PackedFloat32Array(1.0, 0.9)
stage_pop_loss = PackedFloat32Array(0.0, 0.002)
stage_events = Array[Dictionary]([{"meteor": 4.0}, {"meteor": 8.0}])
special = &"star_fall"
invader_race = &"orcs"
unite = false
immune_traits = Array[StringName]([])
start_text = "Небо раскалывается: начинается звёздный дождь, и огонь падает на города."
end_text = "Звёздный дождь утих; в кратерах находят небесное железо."
