[gd_resource type="Resource" script_class="CrisisDef" format=3]

[ext_resource type="Script" path="res://scripts/data/crisis_def.gd" id="1_cr"]

[resource]
script = ExtResource("1_cr")
id = &"great_plague"
display_name = "Великая чума"
description = "Мор идёт от города к городу; живые не успевают хоронить мёртвых."
era_name = "Эпоха Мора"
weight = 1.2
min_year = 80
stage_names = PackedStringArray("Первые вести о море", "Чёрная смерть", "Затухание")
stage_years = PackedInt32Array(4, 10, 8)
stage_effects = Array[Dictionary]([{"growth_mult": 0.8, "trade_mult": 0.9}, {"growth_mult": 0.5, "trade_mult": 0.7, "stability": -0.06}, {"growth_mult": 0.85}])
stage_harvest = PackedFloat32Array(1.0, 0.9, 1.0)
stage_pop_loss = PackedFloat32Array(0.01, 0.03, 0.008)
stage_events = Array[Dictionary]([{"plague": 3.0}, {"plague": 6.0, "great_famine": 2.0}, {"plague": 2.0}])
special = &"plague"
invader_race = &"orcs"
unite = false
immune_traits = Array[StringName]([&"no_food"])
start_text = "Начинается Великая чума: мор идёт по торговым путям, и нет от него спасения."
end_text = "Великая чума отступила. Мир, поредевший, но выживший, оплакивает мёртвых."
