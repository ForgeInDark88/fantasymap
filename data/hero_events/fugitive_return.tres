weight = 1.0
chained = true
options = Array[Dictionary]([{"text": "Принять подарок", "gold": 60.0, "xp": 0.5, "result": "Тяжёлый кошель — честный долг."}, {"text": "Попросить товар в дорогу", "cargo": "spices", "amount": 5, "result": "Он нагружает ваш мешок пряностями."}])
