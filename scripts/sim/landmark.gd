class_name Landmark
extends RefCounted
## Особое место мира, созданное великим деянием или судьбой:
##   source — источник силы (не больше MAX_SOURCES): владелец региона получает
##            силу армии, науку и стабильность;
##   portal — портал в бездну: из него выходят демоны;
##   throne — пустой трон с проклятым оружием (душа героя, заточённая Судьбой);
##            его стережёт чудовище, победитель получает оружие;
##   wonder — чудо света в городе.

const MAX_SOURCES := 2

var id := -1
var kind: StringName
var name := ""
var cell := -1
var created_year := 0
## Герой, который создал место (или заточён в нём — для трона).
var hero_id := -1
var active := true
## Трон: сила стража и название проклятого оружия.
var guardian := 0.0
var artifact := ""
