[gd_resource type="Resource" script_class="HeroEventDef" format=3]

[ext_resource type="Script" path="res://scripts/data/hero_event_def.gd" id="1_ev"]

[resource]
script = ExtResource("1_ev")
id = &"dragon_shadow"
title = "Тень над перевалом"
text = "Пастухи края {where} показывают на обугленные склоны: где-то рядом логово чудовища."
where = &""
terrain = &""
weight = 1.3
requires = &"lair"
options = Array[Dictionary]([{"text": "Взяться за дело", "xp": 0.5, "quest": "lair", "result": "Пастухи показывают тропу."}, {"text": "Расспросить и уйти", "xp": 0.3, "result": "Лучше обойти эти места."}])
